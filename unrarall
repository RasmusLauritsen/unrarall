#!/usr/bin/env bash
set -Eeuo pipefail

VERSION=1.0.0
BACKEND=""
CLEAN=none
DRY=0
FORCE=0
VERBOSE=0
QUIET=0
FULL_PATH=0
OUTPUT=""
PASSWORD_FILE="${HOME}/.unrar_passwords"
SKIP_IF_EXISTS=0
ALLOW_FAILURES=0

usage() {
  cat <<'EOF'
Usage: unrarall [options] DIRECTORY

Extract RAR archives recursively. Multipart sets are discovered from their
first volume and are validated by the extraction backend, not MIME metadata.

Options:
  --clean=HOOK[,HOOK]  Cleanup after successful extraction: none, rar, all
  --force              Continue after checksum failures; permit cleanup
  --dry                Print actions without changing files
  --verbose            Show backend output
  --quiet              Suppress normal output
  --full-path          Preserve paths stored in archives
  --output DIRECTORY   Extract everything into DIRECTORY
  --backend NAME       unrar (default), rar, or 7z
  --password-file FILE Try passwords from FILE, one per line
  --skip-if-exists     Skip when every archive entry already exists
  --allow-failures     Succeed if at least one archive succeeds
  --version            Print version
  --help               Show this help
EOF
}

log() { (( QUIET )) || printf '%s\n' "$*"; }
warn() { (( QUIET )) || printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 2; }

while (($#)); do
  case $1 in
    --clean=*) CLEAN=${1#*=} ;;
    --force|-f) FORCE=1 ;;
    --dry|-d) DRY=1 ;;
    --verbose|-v) VERBOSE=1 ;;
    --quiet|-q) QUIET=1 ;;
    --full-path) FULL_PATH=1 ;;
    --output|-o) shift; (($#)) || die "--output requires a directory"; OUTPUT=$1 ;;
    --backend=*) BACKEND=${1#*=} ;;
    --backend) shift; (($#)) || die "--backend requires a name"; BACKEND=$1 ;;
    --password-file) shift; (($#)) || die "--password-file requires a file"; PASSWORD_FILE=$1 ;;
    --skip-if-exists) SKIP_IF_EXISTS=1 ;;
    --allow-failures) ALLOW_FAILURES=1 ;;
    --version) printf '%s\n' "$VERSION"; exit 0 ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
  shift
done

(($# == 1)) || { usage >&2; exit 2; }
ROOT=$(realpath "$1")
[[ -d $ROOT ]] || die "not a directory: $1"
case $CLEAN in none|rar|all) ;; *) die "unsupported cleanup hook: $CLEAN" ;; esac
case ${BACKEND:-auto} in auto|unrar|rar|7z) ;; *) die "unsupported backend: $BACKEND" ;; esac

if [[ -n $OUTPUT ]]; then OUTPUT=$(realpath -m "$OUTPUT"); (( DRY )) || mkdir -p "$OUTPUT"; fi
if [[ -z $BACKEND ]]; then
  if command -v unrar >/dev/null 2>&1; then BACKEND=unrar
  elif command -v rar >/dev/null 2>&1; then BACKEND=rar
  elif command -v 7z >/dev/null 2>&1; then BACKEND=7z
  else die "no extraction backend found (install unrar, rar, or 7z)"; fi
fi
command -v "$BACKEND" >/dev/null 2>&1 || die "backend not found: $BACKEND"

declare -A seen=()
success=0
failures=0

archive_base() {
  local name=${1##*/}
  if [[ $name =~ ^(.*)\.part[0-9]+\.rar$ ]]; then name=${BASH_REMATCH[1]}
  elif [[ $name =~ ^(.*)\.rar$ ]]; then name=${BASH_REMATCH[1]}
  elif [[ $name =~ ^(.*)\.001$ ]]; then name=${BASH_REMATCH[1]}; fi
  printf '%s' "$name"
}

is_first_volume() {
  local name=${1##*/}
  [[ $name =~ \.rar$ || $name =~ \.part0*1\.rar$ || $name =~ \.001$ ]]
}

already_extracted() {
  local archive=$1 target=$2 entry
  while IFS= read -r entry; do
    [[ -z $entry || $entry == */ ]] && continue
    [[ -e "$target/$entry" ]] || return 1
  done < <(case $BACKEND in
    unrar|rar) "$BACKEND" lb -p- -- "$archive" ;;
    7z) 7z l -slt -p -- "$archive" | awk -F'= ' '/^Path = / { print $2 }' ;;
  esac)
}

extract() {
  local archive=$1 target=$2 password=$3 mode=e
  (( FULL_PATH )) && mode=x
  case $BACKEND in
    unrar|rar) "$BACKEND" "$mode" -o+ -y "-p$password" -- "$archive" "$target/" ;;
    7z) 7z x -y "-p$password" -- "$archive" "-o$target" ;;
  esac
}

extract_with_passwords() {
  local archive=$1 target=$2 password
  if [[ -s $PASSWORD_FILE ]]; then
    while IFS= read -r password || [[ -n $password ]]; do
      extract "$archive" "$target" "$password" && return 0
    done < "$PASSWORD_FILE"
    return 1
  fi
  extract "$archive" "$target" "-"
}

cleanup() {
  local archive=$1 dir=$2 base file name
  [[ $CLEAN != none ]] || return 0
  base=$(archive_base "$archive")
  if [[ $CLEAN == rar || $CLEAN == all ]]; then
    while IFS= read -r -d '' file; do
      name=${file##*/}
      [[ $name =~ ^${base}(\.part[0-9]+)?(\.rar|\.r[0-9]+|\.[0-9]{3}|\.sfv)$ ]] && rm -f -- "$file"
    done < <(find "$dir" -maxdepth 1 -type f -print0)
  fi
  if [[ $CLEAN == all ]]; then
    find "$dir" -type f \( -iname '*.nfo' -o -iname '.DS_Store' -o -iname 'Thumbs.db' \) -delete
    find "$dir" -type d \( -iname covers -o -iname proof -o -iname sample \) -prune -exec rm -rf -- {} +
    find "$dir" -depth -type d -empty -delete
  fi
}

log "Using $BACKEND over directory \"$ROOT\""
# Find archive entry points without splitting filenames on whitespace.
while IFS= read -r -d '' archive; do
  # Only process the first volume; the backend locates the remaining volumes.
  is_first_volume "$archive" || continue
  dir=${archive%/*}
  key="$dir/$(archive_base "$archive")"
  # Avoid processing the same archive set, but keep same-named sets separate.
  [[ ${seen[$key]:-0} == 1 ]] && continue
  seen[$key]=1
  target=${OUTPUT:-$dir}
  if (( SKIP_IF_EXISTS )) && already_extracted "$archive" "$target"; then
    log "Skipping already extracted archive: $archive"
    continue
  fi
  log "Extracting: $archive"
  if (( DRY )); then continue; fi
  # Extract away from the destination so failed or partial archives do not
  # overwrite existing files.
  tmp=$(mktemp -d "$dir/.unrarall.XXXXXX")
  if (( VERBOSE )); then
    if ! extract_with_passwords "$archive" "$tmp"; then
      (( FORCE )) || { rm -rf -- "$tmp"; failures=$((failures + 1)); warn "extraction failed: $archive"; continue; }
    fi
  elif extract_with_passwords "$archive" "$tmp" >/dev/null 2>&1; then :; else
    if (( FORCE )); then
      warn "extraction failed but continuing due to --force: $archive"
    else
      rm -rf -- "$tmp"
      failures=$((failures + 1))
      warn "extraction failed: $archive"
      continue
    fi
  fi
  # Move only files from a successful temporary extraction into the target.
  while IFS= read -r -d '' file; do
    rel=${file#"$tmp"/}
    mkdir -p "$target/$(dirname "$rel")"
    mv -n -- "$file" "$target/$rel"
  done < <(find "$tmp" -type f -print0)
  rm -rf -- "$tmp"
  # Cleanup runs only after extraction and file movement have completed.
  cleanup "$archive" "$dir" || warn "cleanup failed: $dir"
  success=$((success + 1))
  log "OK: $archive"
done < <(find "$ROOT" -type f \( -iname '*.rar' -o -iname '*.001' \) -print0)

# Return failure when nothing extracted, or when any archive failed unless the
# caller explicitly requested that individual failures be allowed.
if (( success == 0 )); then log "no rar files extracted"; exit 1; fi
log "$success archive(s) extracted"
if (( failures && !ALLOW_FAILURES )); then exit 1; fi
